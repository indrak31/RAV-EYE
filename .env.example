# Traffic Violation backend — environment config.
# Copy to .env and edit values. SQLite is the default.

# DATABASE_URL examples:
#   SQLite:      sqlite:///./data/tv.db   (default)
#   Postgres:   postgresql+psycopg://tv:tv@localhost:5432/tv
DATABASE_URL=sqlite:///./data/tv.db

# App
APP_NAME=tv-backend
APP_VERSION=v1
ENV=dev
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Media storage (evidence frames/clips)
MEDIA_DIR=./media